{
  "info": {
    "name": "AutomationExercise API Testing",
    "description": "14 APIs from https://automationexercise.com. Run the whole collection in order: the User folder creates an account, uses it, then deletes it. The API returns HTTP 200 and puts the real result in responseCode.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://automationexercise.com"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "Password123"
    }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "API 1 - Get all products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productsList",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productsList"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('responseCode is 200', () => pm.expect(body.responseCode).to.eql(200));",
                  "pm.test('products list is not empty', () => pm.expect(body.products).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "API 2 - POST to products list (negative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
