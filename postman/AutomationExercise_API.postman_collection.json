          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('HTTP status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('responseCode is 405', () => pm.expect(body.responseCode).to.eql(405));",
                  "pm.test('message is correct', () => pm.expect(body.message).to.eql(\"This request method is not supported.\"));"
                ]
              }
            }
          ]
        },
